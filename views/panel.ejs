<script>
/* ================================================================ */
/* Almacenamiento compartido: los datasets viven en la base de      */
/* datos del servidor (Neon Postgres) vía /api/datos/:clave.        */
/* ================================================================ */
window.storage = {
  async get(clave) {
    const r = await fetch('/api/datos/' + encodeURIComponent(clave));
    if (!r.ok) throw new Error('no se pudieron leer los datos del servidor (' + r.status + ')');
    return r.json(); // { value: string | null }
  },
  async set(clave, value) {
    const r = await fetch('/api/datos/' + encodeURIComponent(clave), {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ value }),
    });
    if (!r.ok) throw new Error('el servidor respondió ' + r.status);
  },
};
</script>
<script>
/* ================================================================ */
/* Helpers comunes                                                   */
/* ================================================================ */
const $ = id => document.getElementById(id);
/* los inputs de carga solo existen para administradores */
const onChange = (id, fn) => { const el = $(id); if (el) el.addEventListener('change', fn); };
const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
const pct = (n, d) => d ? Math.round(n / d * 100) + '%' : '–';

/* ================================================================ */
/* Carga de Excel: un archivo puede traer la carga completa o solo   */
/* uno o varios meses. Regla: los meses que vienen en el archivo     */
/* nuevo reemplazan a los que ya había guardados para ese mes; los   */
/* meses que no vienen en el archivo nuevo se conservan tal cual.    */
/* ================================================================ */
function mergeRecordsByMonth(oldRecords, newRecords, monthKeyFn) {
  if (!oldRecords || !oldRecords.length) return newRecords.slice();
  const newMonths = new Set(newRecords.map(monthKeyFn));
  const kept = oldRecords.filter(r => !newMonths.has(monthKeyFn(r)));
  return kept.concat(newRecords);
}

const tip = $('tip');
document.addEventListener('mouseover', e => {
  const t = e.target.closest('[data-tip]');
  if (t) { tip.innerHTML = t.dataset.tip; tip.style.display = 'block'; }
  else tip.style.display = 'none';
});
document.addEventListener('mousemove', e => {
  if (tip.style.display !== 'block') return;
  const pad = 14;
  let x = e.clientX + pad, yy = e.clientY + pad;
  const r = tip.getBoundingClientRect();
  if (x + r.width > innerWidth - 8) x = e.clientX - r.width - pad;
  if (yy + r.height > innerHeight - 8) yy = e.clientY - r.height - pad;
  tip.style.left = x + 'px'; tip.style.top = yy + 'px';
});

function renderHBars(el, items, tipLabel) {
  const max = Math.max(...items.map(d => Math.abs(d.n)), 1);
  el.innerHTML = items.map(d => {
    const w = (Math.abs(d.n) / max * 100).toFixed(1);
    const left = d.n < 0 ? (100 - w) : 0;
    return `
    <div class="hrow" data-tip="${esc(d.tip || (`<b>${d.label}</b><br>${d.n} · ${tipLabel || ''}`))}">
      <span class="hl" title="${esc(d.label)}">${esc(d.label)}</span>
      <span class="track"><span class="bar" style="width:${w}%; left:${left}%; background:${d.color}"></span></span>
      <span class="hv">${d.n > 0 ? '+' : ''}${d.n}</span>
    </div>`;
  }).join('');
}
function countBy(arr, key) {
  const m = new Map();
  arr.forEach(r => { const k = key(r); m.set(k, (m.get(k) || 0) + 1); });
  return m;
}

