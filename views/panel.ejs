}
async function parseExcelFile(file) {
  const buf = await file.arrayBuffer();
  const wb = XLSX.read(buf, { type: 'array', cellDates: true });
  const sheetName = wb.SheetNames.find(n => n.trim().toUpperCase() === 'BAJAS') || wb.SheetNames[0];
  const ws = wb.Sheets[sheetName];
  const rows = XLSX.utils.sheet_to_json(ws, { header: 1, raw: true, defval: null });
  if (!rows.length) throw new Error('La hoja está vacía.');
  const headerRowIdx = findHeaderRowIndex(rows, 'Empleado (Cod)');
  if (headerRowIdx === -1) throw new Error('No se encontró la fila de encabezados ("Empleado (Cod)", "Motivo medida"…) en la hoja.');
  const header = rows[headerRowIdx].map(h => (h == null ? '' : String(h)).trim());
  const col = name => header.findIndex(h => h.toLowerCase() === name.toLowerCase());
  const idx = {
    cod: col('Empleado (Cod)'), nombre: col('Empleado'), motivo: col('Motivo medida'),
    div: col('Div Personal'), genero: col('Género'), mes: col('MES'),
    dir: col('DIRECCION'), ger: col('GERENCIA'), bp: col('BP'),
    suc: col('Sucesor'), sucDetalle: col('Detalle del motivo'),
    retencion: col('Acciones de retención'), encuesta: col('Encuesta de salida'),
  };
  for (const k of ['cod', 'nombre', 'motivo', 'div', 'genero', 'mes']) {
    if (idx[k] === -1) throw new Error(`Falta la columna requerida "${k}" en la hoja de bajas.`);
  }
  const out = [];
  let skippedIdentity = 0, skippedFecha = 0, unclassifiedMotivo = 0;
  for (let r = headerRowIdx + 1; r < rows.length; r++) {
    const row = rows[r];
    if (!row) continue;
    const cod = row[idx.cod], nombre = row[idx.nombre];
    if ((cod == null || cod === '') && !nombre) continue;
    if (cod == null || cod === '' || !nombre) { skippedIdentity++; continue; }
    const motivoRaw = (row[idx.motivo] == null ? '' : String(row[idx.motivo])).trim();
    const mm = parseMotivo(motivoRaw);
    if (mm[0] === 'S') unclassifiedMotivo++;
    const site = (row[idx.div] == null ? '' : String(row[idx.div])).trim();
    const md = monthFromCell(row[idx.mes]);
    if (!md) { skippedFecha++; continue; }
    const bp = (row[idx.bp] == null ? '' : String(row[idx.bp])).trim() || 'Sin dato';
    const field = i => (i === -1 || row[i] == null) ? '' : String(row[i]).trim();
    out.push({
      n: String(nombre),
      g: (row[idx.genero] == null ? '' : String(row[idx.genero])).trim() === 'Masculino' ? 'M' : 'F',
      t: mm[0],
      m: mm[1], s: site,
      f: `${md.year}-${String(md.month).padStart(2, '0')}-01`,
      mes: md.month, dir: titleDir(row[idx.dir]), ger: formatGerencia(row[idx.ger]), bp,
      suc: field(idx.suc), sucDetalle: field(idx.sucDetalle), retencion: field(idx.retencion), encuesta: field(idx.encuesta),
    });
