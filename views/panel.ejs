}
[$('altas-card-g-total'), $('altas-card-g-m'), $('altas-card-g-f')].forEach(el => el.addEventListener('click', () => {
  setActiveAltasGenderCard(altasState.genero === el.dataset.g ? '' : el.dataset.g);
  altasRender();
}));

function altasFiltered(opts) {
  opts = opts || {};
  return ALTAS_DATA.filter(r =>
    (!altasState.mes || r.mes === +altasState.mes) &&
    (!altasState.sitio || r.s === altasState.sitio) &&
    (opts.skipGenero || !altasState.genero || r.g === altasState.genero) &&
    (!altasState.motivo || motivoBucket(r.mo) === altasState.motivo) &&
    (!altasState.vacante || (altasState.vacante === 'si' ? !!r.vacante : !r.vacante)) &&
    (!altasState.q || altasSearchBlob(r).includes(altasState.q)));
}
/* filtro sin género, usado para el gráfico de diversidad y la comparación de género por planta */
function altasFilteredNoGenero() { return altasFiltered({ skipGenero: true }); }
/* filtro solo por sitio (ignora el resto) — para reconstruir la serie mensual completa de un sitio */
function altasFilteredBySiteOnly(site) {
  return ALTAS_DATA.filter(r => !site || r.s === site);
}
/* bajas (usa el array DATA de la vista de Bajas, ya cargado en el mismo script) filtradas por sitio */
function bajasFilteredBySiteOnly(site) {
  return DATA.filter(r => !site || r.s === site);
}

function altasRenderKPIs(rows) {
  const total = rows.length;
  const porMes = countBy(rows, r => r.mes);
  let pico = null;
  porMes.forEach((n, mi) => { if (!pico || n > pico[1]) pico = [mi, n]; });
  $('altas-k-pico').textContent = pico ? MES_NOM[pico[0]] : '–';
  $('altas-k-pico-sub').textContent = pico ? `${pico[1]} altas` : '';
  const cubiertas = rows.filter(r => r.vacante).length;
  $('altas-k-vac').textContent = cubiertas;
  $('altas-k-vac-sub').textContent = pct(cubiertas, total) + ' del total filtrado';
}
function altasRenderGenderCards(rows) {
  const total = rows.length;
  const f = rows.filter(r => r.g === 'F').length;
  const m = total - f;
  $('altas-k-total').textContent = total;
  $('altas-k-total-sub').textContent = total === ALTAS_DATA.length ? ALTAS_PERIOD_LABEL : `de ${ALTAS_DATA.length} en el período`;
  $('altas-k-f').textContent = f;
  $('altas-k-f-sub').textContent = pct(f, total) + ' del total filtrado';
  $('altas-k-m').textContent = m;
  $('altas-k-m-sub').textContent = pct(m, total) + ' del total filtrado';
}
function altasRenderMes(rows) {
  const W = 680, H = 250, mL = 30, mR = 8, mT = 26, mB = 24;
  const iw = W - mL - mR, ih = H - mT - mB;
  const perMes = ALTAS_MESES.map(mi => {
    const m = rows.filter(r => r.mes === mi && r.g === 'M').length;
    const f = rows.filter(r => r.mes === mi && r.g === 'F').length;
    return { mi, m, f, tot: m + f };
  });
  const maxTot = Math.max(...perMes.map(d => d.tot), 1);
  const yMax = Math.max(5, Math.ceil(maxTot / 5) * 5);
  const y = val => mT + ih - (val / yMax) * ih;
  const step = iw / (ALTAS_MESES.length || 1);
  const bw = Math.min(52, step * 0.5);
  const GAP = 2;
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Altas por mes, apiladas por género">`;
  for (let t = 0; t <= yMax; t += 5) {
    s += `<line x1="${mL}" x2="${W - mR}" y1="${y(t)}" y2="${y(t)}" stroke="${t === 0 ? 'var(--baseline)' : 'var(--grid)'}" stroke-width="1"/>`;
    s += `<text x="${mL - 6}" y="${y(t) + 4}" text-anchor="end" font-size="11" fill="var(--muted)">${t}</text>`;
  }
  perMes.forEach((d, idx) => {
    const cx = mL + step * idx + step / 2;
    const x = cx - bw / 2;
    const hM = (d.m / yMax) * ih;
    const hF = (d.f / yMax) * ih;
    const yM = y(d.m);
    const r = 4;
    if (d.f > 0) {
      const yF = yM - GAP - hF;
      const hFc = Math.max(hF - 0, 1.5);
      s += roundedTop(x, yF, bw, hFc, r, 'var(--i)');
      if (d.m > 0) s += `<rect x="${x}" y="${yM}" width="${bw}" height="${Math.max(hM, 1.5)}" fill="var(--v)"/>`;
    } else if (d.m > 0) {
      s += roundedTop(x, yM, bw, Math.max(hM, 1.5), r, 'var(--v)');
    }
    if (d.tot > 0) s += `<text x="${cx}" y="${(d.f > 0 ? yM - GAP - hF : yM) - 6}" text-anchor="middle" font-size="12" fill="var(--ink-2)">${d.tot}</text>`;
    s += `<text x="${cx}" y="${H - 6}" text-anchor="middle" font-size="11.5" fill="var(--muted)">${MES_ABR[d.mi]}</text>`;
    s += `<rect x="${mL + step * idx}" y="${mT}" width="${step}" height="${ih}" fill="transparent" data-tip="${esc(`<b>${MES_NOM[d.mi]}</b> — ${d.tot} alta${d.tot === 1 ? '' : 's'}<br>Masculino: <b>${d.m}</b> · Femenino: <b>${d.f}</b>`)}"/>`;
  });
  s += '</svg>';
  $('altas-c-mes').innerHTML = s;
}
function altasRenderSitio(rows) {
  const items = [...countBy(rows, r => r.s).entries()]
    .map(([label, n]) => ({ label, n, total: rows.length, color: 'var(--v)' }))
    .sort((a, b) => b.n - a.n);
  renderBajasHBars($('altas-c-sitio'), items, 'del total filtrado');
}
function altasRenderGeneroPorSitio(rows) {
  const m = new Map();
  rows.forEach(r => {
    const cur = m.get(r.s) || { f: 0, m: 0 };
    if (r.g === 'F') cur.f++; else cur.m++;
    m.set(r.s, cur);
  });
  const items = [...m.entries()].map(([label, v]) => ({ label, f: v.f, m: v.m, total: v.f + v.m }))
    .sort((a, b) => b.total - a.total);
  const max = Math.max(...items.map(d => d.total), 1);
  $('altas-c-genero-sitio').innerHTML = items.map(d => {
    const wF = (d.f / max * 100).toFixed(1), wM = (d.m / max * 100).toFixed(1);
    return `
    <div class="hrow" data-tip="${esc(`<b>${d.label}</b><br>Femenino: <b>${d.f}</b> · Masculino: <b>${d.m}</b> · Total: <b>${d.total}</b>`)}">
      <span class="hl" title="${esc(d.label)}">${esc(d.label)}</span>
      <span class="track"><span class="bar" style="width:${wF}%; left:0; background:var(--i)"></span><span class="bar" style="width:${wM}%; left:${wF}%; background:var(--v)"></span></span>
      <span class="hv">${d.total}</span>
    </div>`;
  }).join('');
}
function altasDiversidadSerie(site) {
  /* Serie mensual de % mujeres para un sitio (o compañía completa si site es ''), usando la
     dotación real cerrada de cada mes tal como viene del Excel de % Mujeres — no es una estimación
     por altas menos bajas, es el headcount real de cada cierre mensual. */
  const monthKeys = mujeresMonthKeys();
  const meses = monthKeys.length ? monthKeys.map(k => MES_NUM_MAP[k]) : [1];
  return meses.map(mi => {
    const d = mujeresFor(mi, site);
    return { mi, f: d.f, tot: d.tot, pctF: d.tot ? (d.f / d.tot * 100) : null };
  });
}
function altasRenderDiversidad() {
  /* Small multiples: un mini-gráfico por planta en vez de todas las líneas superpuestas — mismo dato
     (dotación real por mes desde el Excel de % Mujeres), mucho más fácil de leer de un vistazo. */
  const sites = mujeresSiteList();
  if (!sites.length) {
    $('altas-c-diversidad').innerHTML = '<p style="color:var(--muted); font-size:13px;">Todavía no se cargó el Excel de % Mujeres — usá el botón de arriba.</p>';
    $('altas-div-legend').innerHTML = '';
    return;
  }
  const total = altasDiversidadSerie('');
  const entries = [{ label: 'Total compañía', pts: total, isTotal: true }, ...sites.map(site => ({ label: site, pts: altasDiversidadSerie(site), isTotal: false }))];

  function miniCard({ label, pts, isTotal }) {
    const W = 150, H = 46, pad = 4;
    const first = pts.find(p => p.pctF != null);
    const last = [...pts].reverse().find(p => p.pctF != null);
    const cur = last ? Math.round(last.pctF) : null;
    const ene = first ? Math.round(first.pctF) : null;
    const delta = (cur != null && ene != null) ? cur - ene : null;
    const trendColor = delta == null ? 'var(--muted)' : (delta >= 0 ? 'var(--i)' : 'var(--neg)');
    const yMax = 100;
    const y = v => pad + (H - 2 * pad) - (v / yMax) * (H - 2 * pad);
    const step = (W - 2 * pad) / (pts.length - 1 || 1);
    const px = idx => pad + step * idx;
    let d = '';
    pts.forEach((pt, idx) => { if (pt.pctF != null) { d += `${d === '' ? 'M' : 'L'}${px(idx)},${y(pt.pctF)} `; } });
    let dots = '';
    pts.forEach((pt, idx) => {
      if (pt.pctF == null) return;
      dots += `<circle cx="${px(idx)}" cy="${y(pt.pctF)}" r="2" fill="${trendColor}" data-tip="${esc(`<b>${label}</b> — ${MES_NOM[pt.mi]}<br>% mujeres: <b>${Math.round(pt.pctF)}%</b> (${pt.f} de ${pt.tot})`)}"/>`;
    });
    const svg = `<svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}" preserveAspectRatio="none" role="img" aria-label="Trayectoria de % mujeres — ${esc(label)}">
      <line x1="${pad}" x2="${W - pad}" y1="${y(50)}" y2="${y(50)}" stroke="var(--grid)" stroke-width="1" stroke-dasharray="2 2"/>
      <path d="${d}" fill="none" stroke="${trendColor}" stroke-width="1.8"/>
      ${dots}
    </svg>`;
    const deltaTxt = delta == null ? '' : `<span style="color:${delta >= 0 ? 'var(--i)' : 'var(--neg)'};">${delta > 0 ? '+' : ''}${delta} p.p. vs. ene.</span>`;
    return `<div style="border:1px solid var(--border); border-radius:8px; padding:8px 10px; background:var(--surface); ${isTotal ? 'border-color:var(--ink);' : ''}">
      <div style="display:flex; justify-content:space-between; align-items:baseline; gap:6px;">
        <span style="font-size:11.5px; font-weight:${isTotal ? 700 : 600}; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${esc(label)}">${esc(label)}</span>
        <span style="font-size:13px; font-weight:700; color:var(--ink);">${cur != null ? cur + '%' : '–'}</span>
      </div>
      ${svg}
      <div style="font-size:10.5px; color:var(--muted); margin-top:2px;">${deltaTxt}</div>
    </div>`;
  }

  $('altas-c-diversidad').innerHTML =
    `<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:10px;">${entries.map(miniCard).join('')}</div>`;
  $('altas-div-legend').innerHTML =
    `<span>Cada mini-gráfico va de 0% a 100%; la línea punteada marca el 50%. Color verde = subió respecto a enero, rojo = bajó.</span>`;
}
function altasRenderDiversidadTabla() {
  const monthKeys = mujeresMonthKeys();
  const primerMi = monthKeys.length ? MES_NUM_MAP[monthKeys[0]] : 1;
  const lastMi = monthKeys.length ? MES_NUM_MAP[monthKeys[monthKeys.length - 1]] : 1;
  const hastaMi = altasState.mes ? +altasState.mes : lastMi;
  ['altas-div-mes-lbl', 'altas-div-mes-lbl2', 'altas-div-mes-lbl3', 'altas-div-mes-lbl4'].forEach(id => { $(id).textContent = MES_ABR[hastaMi]; });
  const sites = mujeresSiteList().slice().sort((a, b) => a.localeCompare(b, 'es'));
  const rowsHtml = sites.map(site => {
    const base = mujeresFor(primerMi, site);
    const pctEne = base.tot ? (base.f / base.tot * 100) : null;
    const rowsSite = altasFilteredBySiteOnly(site).filter(r => r.mes > primerMi && r.mes <= hastaMi);
    const bajasSite = bajasFilteredBySiteOnly(site).filter(r => r.mes > primerMi && r.mes <= hastaMi);
    const altasF = rowsSite.filter(r => r.g === 'F').length;
    const altasM = rowsSite.filter(r => r.g === 'M').length;
    const bajasF = bajasSite.filter(r => r.g === 'F').length;
    const bajasM = bajasSite.filter(r => r.g === 'M').length;
    /* dotación y % actual: dato real del mes seleccionado, no una estimación por altas-bajas */
    const cur = mujeresFor(hastaMi, site);
    const pctCur = cur.tot ? (cur.f / cur.tot * 100) : null;
    const delta = (pctEne != null && pctCur != null) ? (pctCur - pctEne) : null;
    return `<tr>
      <td>${esc(site)}</td>
      <td class="num">${base.tot}</td>
      <td class="num">${pctEne != null ? Math.round(pctEne) + '%' : '–'}</td>
      <td class="num">${altasF}</td>
      <td class="num">${altasM}</td>
      <td class="num">${bajasF}</td>
      <td class="num">${bajasM}</td>
      <td class="num">${cur.tot}</td>
      <td class="num">${pctCur != null ? Math.round(pctCur) + '%' : '–'}</td>
      <td class="num">${delta != null ? `<span class="pill ${delta >= 0 ? 'pos' : 'neg'}">${delta > 0 ? '+' : ''}${delta.toFixed(1)}</span>` : '–'}</td>
    </tr>`;
  }).join('');
  $('altas-div-tbody').innerHTML = rowsHtml;
}
function altasRenderTable(rows) {
  const list = rows.slice().sort((a, b) => a.f.localeCompare(b.f));
  $('altas-tbody').innerHTML = list.map(r => {
    const [y, mo, d] = r.f.split('-');
    return `<tr>
      <td>${esc(r.n)}</td><td class="num">${d}/${mo}/${y}</td>
      <td><span class="pill ${r.g === 'F' ? 'I' : 'V'}">${r.g === 'F' ? 'Femenino' : 'Masculino'}</span></td>
      <td title="${esc(r.mo)}">${esc(r.mo)}</td><td>${esc(r.s)}</td>
      <td>${r.vacante ? `<span class="pill pos" data-tip="${esc(r.vacante)}${r.cobertura ? ' — ' + esc(r.cobertura) : ''}">Sí</span>` : '<span class="pill S">No</span>'}</td>
    </tr>`;
  }).join('');
  $('altas-tempty').hidden = list.length > 0;
  $('altas-tcount').textContent = `${list.length} de ${ALTAS_DATA.length} registros`;
}
function altasRender() {
  const rows = altasFiltered();
  const rowsNoGenero = altasFilteredNoGenero();
  $('altas-f-clear').classList.toggle('on', !!(altasState.mes || altasState.sitio || altasState.genero || (altasState.motivo && altasState.motivo !== ALTAS_MOTIVO_DEFAULT) || altasState.vacante || altasState.q));
  altasRenderGenderCards(rowsNoGenero);
  altasRenderKPIs(rows);
  altasRenderMes(rows);
  altasRenderSitio(rows);
  altasRenderGeneroPorSitio(rowsNoGenero);
  altasRenderDiversidad();
  altasRenderDiversidadTabla();
  altasRenderTable(rows);
}
async function altasInit() {
  try {
    const stored = await window.storage.get('altas-dataset', true);
    if (stored && stored.value) {
      const parsed = JSON.parse(stored.value);
      if (parsed && Array.isArray(parsed.records) && parsed.records.length) {
        ALTAS_DATA = parsed.records;
        const fecha = parsed.uploadedAt ? new Date(parsed.uploadedAt).toLocaleString('es-AR') : '';
        $('altas-upload-status').textContent = `Últimos datos cargados: "${parsed.filename || 'archivo'}"${fecha ? ' · ' + fecha : ''}`;
        $('altas-upload-status').className = 'upload-status ok';
      }
    }
  } catch (err) {}
  try {
    const stored = await window.storage.get('mujeres-dataset', true);
    if (stored && stored.value) {
      const parsed = JSON.parse(stored.value);
      if (parsed && parsed.meses && Object.keys(parsed.meses).length) {
        MUJERES_DATA = parsed.meses;
        const fecha = parsed.uploadedAt ? new Date(parsed.uploadedAt).toLocaleString('es-AR') : '';
        $('mujeres-upload-status').textContent = `Últimos datos cargados: "${parsed.filename || 'archivo'}"${fecha ? ' · ' + fecha : ''}`;
        $('mujeres-upload-status').className = 'upload-status ok';
      }
    }
  } catch (err) {}
  altasInitFiltersAndRender();
  altasUpdateMeta();
}
onChange('altas-file-input', async (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const statusEl = $('altas-upload-status');
  statusEl.textContent = 'Procesando archivo…'; statusEl.className = 'upload-status';
  try {
    const { records: newRecords, skippedFecha } = await parseAltasFile(file);
    if (!newRecords.length) throw new Error('No se encontraron registros válidos en la hoja de altas.');
    const records = mergeRecordsByMonth(ALTAS_DATA, newRecords, r => r.f.slice(0, 7));
    ALTAS_DATA = records;
    const uploadedAt = new Date().toISOString();
    try { await window.storage.set('altas-dataset', JSON.stringify({ records, uploadedAt, filename: file.name }), true); }
    catch (err) { throw new Error(`El archivo se procesó pero NO se guardó en el servidor (${err.message}). Los demás usuarios no van a ver este cambio: probá de nuevo.`); }
    altasInitFiltersAndRender(); altasUpdateMeta();
    let msg = `✓ ${newRecords.length} registros cargados desde "${file.name}" (${records.length} en total tras combinar meses).`;
    if (skippedFecha) msg += ` ${skippedFecha} fila(s) con fecha inválida omitida(s).`;
    statusEl.textContent = msg; statusEl.className = 'upload-status ok';
  } catch (err) { statusEl.textContent = '⚠ ' + err.message; statusEl.className = 'upload-status err'; }
  e.target.value = '';
});
onChange('mujeres-file-input', async (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const statusEl = $('mujeres-upload-status');
  statusEl.textContent = 'Procesando archivo…'; statusEl.className = 'upload-status';
  try {
    const newMeses = await parseMujeresFile(file);
    const meses = Object.assign({}, MUJERES_DATA, newMeses); // los meses nuevos reemplazan, el resto se conserva
    MUJERES_DATA = meses;
    const uploadedAt = new Date().toISOString();
    try { await window.storage.set('mujeres-dataset', JSON.stringify({ meses, uploadedAt, filename: file.name }), true); }
    catch (err) { throw new Error(`El archivo se procesó pero NO se guardó en el servidor (${err.message}). Los demás usuarios no van a ver este cambio: probá de nuevo.`); }
    altasRender();
    const nuevos = Object.keys(newMeses).length;
    statusEl.textContent = `✓ ${nuevos} mes(es) cargado(s) desde "${file.name}" (${Object.keys(meses).length} en total tras combinar).`;
    statusEl.className = 'upload-status ok';
  } catch (err) { statusEl.textContent = '⚠ ' + err.message; statusEl.className = 'upload-status err'; }
  e.target.value = '';
});

/* ================================================================ */
/* VISTA: SUCESIÓN DE POSICIONES (SEMAFORO.xlsx)                    */
/* Reporte 100% nuevo e independiente: lista posiciones clave por    */
/* planta con su semáforo de riesgo. No se cruza fila a fila con     */
/* bajas — en Bajas, el sucesor sale directo de su propia columna    */
/* "Sucesor" (Si/No/vacío).                                          */
/* ================================================================ */
let SUC_DATA = { posiciones: [], personas: [] };
function semaforoEstadoKey(raw) {
  const n = normalizeMotivo(raw);
  if (n.includes('verde')) return 'verde';
  if (n.includes('amarillo')) return 'amarillo';
  if (n.includes('rojo')) return 'rojo';
  return 'sin-dato';
}
async function parseSemaforoFile(file) {
  const buf = await file.arrayBuffer();
  const wb = XLSX.read(buf, { type: 'array', cellDates: true });
  const sheetName = wb.SheetNames.find(n => n.trim().toLowerCase() === 'hoja1') || wb.SheetNames[0];
  const ws = wb.Sheets[sheetName];
  const rows = XLSX.utils.sheet_to_json(ws, { header: 1, raw: true, defval: null });
  if (!rows.length) throw new Error('La hoja está vacía.');
  const headerRowIdx = findHeaderRowIndex(rows, 'Posición');
  if (headerRowIdx === -1) throw new Error('No se encontró la fila de encabezados ("Posición", "Estado (Semáforo)"…) en la hoja.');
  const header = rows[headerRowIdx].map(h => (h == null ? '' : String(h)).trim());
  const col = (name, from) => {
    for (let i = (from || 0); i < header.length; i++) if (header[i].toLowerCase() === name.toLowerCase()) return i;
    return -1;
  };
  const idxPos = { posicion: col('Posición'), readyNow: col('Ready Now'), inDev: col('In Development'), inCons: col('In Consideration'), planta: col('Planta'), estado: col('Estado (Semáforo)') };
  /* la segunda tabla (personas con plan de desarrollo) repite "Posición" más adelante en la misma fila */
  const idxPer = { nombre: col('Nombre'), posicion: col('Posición', idxPos.estado + 1), site: col('Site'), banda: col('% BANDA'), gap: col('GAP'), acciones: col('Acciones') };
  for (const k of ['posicion', 'planta', 'estado']) {
    if (idxPos[k] === -1) throw new Error(`Falta la columna requerida "${k}" en la hoja de sucesión.`);
  }
  const field = (row, i) => (i === -1 || row[i] == null) ? '' : String(row[i]).trim();
  const fieldPct = (row, i) => {
    if (i === -1 || row[i] == null || row[i] === '') return '';
    return typeof row[i] === 'number' ? Math.round(row[i] * 100) + '%' : String(row[i]).trim();
  };
  const posiciones = [];
  const personas = [];
  for (let r = headerRowIdx + 1; r < rows.length; r++) {
    const row = rows[r];
    if (!row) continue;
    const posicion = field(row, idxPos.posicion), planta = field(row, idxPos.planta);
    if (posicion && planta) {
      const estadoRaw = field(row, idxPos.estado);
      posiciones.push({
        posicion, planta,
        readyNow: field(row, idxPos.readyNow), inDevelopment: field(row, idxPos.inDev), inConsideration: field(row, idxPos.inCons),
        estadoRaw, estado: semaforoEstadoKey(estadoRaw),
      });
    }
    if (idxPer.nombre > -1) {
      const nombre = field(row, idxPer.nombre);
      if (nombre) {
        personas.push({
          nombre, posicion: field(row, idxPer.posicion), site: field(row, idxPer.site),
          banda: fieldPct(row, idxPer.banda), gap: field(row, idxPer.gap), acciones: field(row, idxPer.acciones),
        });
      }
    }
  }
  if (!posiciones.length) throw new Error('No se encontraron posiciones válidas en la hoja.');
  return { posiciones, personas };
}
const sucState = { planta: '', estado: '', q: '' };
function sucSearchBlob(p) {
  return [p.posicion, p.planta, p.readyNow, p.inDevelopment, p.inConsideration, p.estadoRaw].filter(Boolean).join(' ').toLowerCase();
}
function sucFiltered() {
  return SUC_DATA.posiciones.filter(p =>
    (!sucState.planta || p.planta === sucState.planta) &&
    (!sucState.estado || p.estado === sucState.estado) &&
    (!sucState.q || sucSearchBlob(p).includes(sucState.q)));
}
function sucInitFiltersAndRender() {
  $('suc-f-planta').innerHTML = '<option value="">Todas</option>' +
    [...new Set(SUC_DATA.posiciones.map(p => p.planta))].sort((a, b) => a.localeCompare(b, 'es')).map(p => `<option value="${esc(p)}">${esc(p)}</option>`).join('');
  sucState.planta = ''; sucState.estado = ''; sucState.q = '';
  $('suc-f-planta').value = ''; $('suc-f-estado').value = ''; $('suc-q').value = '';
  sucRender();
}
['suc-f-planta', 'suc-f-estado'].forEach(id => $(id).addEventListener('change', () => {
  sucState.planta = $('suc-f-planta').value; sucState.estado = $('suc-f-estado').value;
  sucRender();
}));
$('suc-f-clear').addEventListener('click', () => {
  sucState.planta = sucState.estado = sucState.q = '';
  $('suc-f-planta').value = $('suc-f-estado').value = ''; $('suc-q').value = '';
  sucRender();
});
$('suc-q').addEventListener('input', e => { sucState.q = e.target.value.trim().toLowerCase(); sucRender(); });
const SUC_ESTADO_LABEL = { verde: 'Verde', amarillo: 'Amarillo', rojo: 'Rojo', 'sin-dato': 'Sin dato' };
const SUC_ESTADO_PILL = { verde: 'pos', amarillo: 'S', rojo: 'neg', 'sin-dato': 'S' };
function sucRenderKPIs(rows) {
  const total = rows.length;
  const verde = rows.filter(p => p.estado === 'verde').length;
  const amarillo = rows.filter(p => p.estado === 'amarillo').length;
  const rojo = rows.filter(p => p.estado === 'rojo').length;
  $('suc-k-total').textContent = total;
  $('suc-k-total-sub').textContent = 'posiciones filtradas';
  $('suc-k-verde').textContent = verde; $('suc-k-verde-sub').textContent = pct(verde, total) + ' del total';
  $('suc-k-amarillo').textContent = amarillo; $('suc-k-amarillo-sub').textContent = pct(amarillo, total) + ' del total';
  $('suc-k-rojo').textContent = rojo; $('suc-k-rojo-sub').textContent = pct(rojo, total) + ' del total';
}
function sucRenderTable(rows) {
  $('suc-tbody').innerHTML = rows.map(p => `<tr>
    <td>${esc(p.posicion)}</td><td>${esc(p.planta)}</td>
    <td>${esc(p.readyNow) || '—'}</td><td>${esc(p.inDevelopment) || '—'}</td><td>${esc(p.inConsideration) || '—'}</td>
    <td><span class="pill ${SUC_ESTADO_PILL[p.estado]}">${SUC_ESTADO_LABEL[p.estado]}</span></td>
  </tr>`).join('');
  $('suc-tempty').hidden = rows.length > 0;
  $('suc-tcount').textContent = `${rows.length} de ${SUC_DATA.posiciones.length} posiciones`;
}
function sucRenderPeopleTable() {
  const list = SUC_DATA.personas;
  $('suc-people-tbody').innerHTML = list.map(p => `<tr>
    <td>${esc(p.nombre)}</td><td>${esc(p.posicion) || '—'}</td><td>${esc(p.site) || '—'}</td>
    <td class="num">${esc(p.banda) || '—'}</td><td title="${esc(p.gap)}">${esc(p.gap) || '—'}</td><td title="${esc(p.acciones)}">${esc(p.acciones) || '—'}</td>
  </tr>`).join('');
  $('suc-people-tempty').hidden = list.length > 0;
}
function sucUpdateFooter() {
  $('suc-footer-text').textContent = `Elaborado a partir de la planilla de sucesión (${SUC_DATA.posiciones.length} posiciones${SUC_DATA.personas.length ? `, ${SUC_DATA.personas.length} personas con plan de desarrollo` : ''}).`;
}
function sucRender() {
  const rows = sucFiltered();
  $('suc-f-clear').classList.toggle('on', !!(sucState.planta || sucState.estado || sucState.q));
  sucRenderKPIs(rows);
  sucRenderTable(rows);
  sucRenderPeopleTable();
}
/* Una posición ya cargada (misma planta + mismo nombre de posición) se reemplaza; las que no
   vienen en el archivo nuevo se conservan; una posición nueva se agrega. */
function mergeSucesionByKey(oldPos, newPos) {
  if (!oldPos || !oldPos.length) return newPos;
  const byKey = new Map(oldPos.map(p => [siteKey(p.planta) + '|' + siteKey(p.posicion), p]));
  newPos.forEach(np => byKey.set(siteKey(np.planta) + '|' + siteKey(np.posicion), np));
  return [...byKey.values()];
}
async function sucInit() {
  try {
    const stored = await window.storage.get('semaforo-dataset', true);
    if (stored && stored.value) {
      const parsed = JSON.parse(stored.value);
      if (parsed && Array.isArray(parsed.posiciones) && parsed.posiciones.length) {
        SUC_DATA = { posiciones: parsed.posiciones, personas: parsed.personas || [] };
        const fecha = parsed.uploadedAt ? new Date(parsed.uploadedAt).toLocaleString('es-AR') : '';
        $('suc-upload-status').textContent = `Últimos datos cargados: "${parsed.filename || 'archivo'}"${fecha ? ' · ' + fecha : ''}`;
        $('suc-upload-status').className = 'upload-status ok';
      }
    }
  } catch (err) {}
  sucInitFiltersAndRender();
  sucUpdateFooter();
}
onChange('suc-file-input', async (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const statusEl = $('suc-upload-status');
  statusEl.textContent = 'Procesando archivo…'; statusEl.className = 'upload-status';
  try {
    const { posiciones: newPos, personas: newPer } = await parseSemaforoFile(file);
    const posiciones = mergeSucesionByKey(SUC_DATA.posiciones, newPos);
    const personas = newPer.length ? newPer : SUC_DATA.personas;
    SUC_DATA = { posiciones, personas };
    const uploadedAt = new Date().toISOString();
    try { await window.storage.set('semaforo-dataset', JSON.stringify({ posiciones, personas, uploadedAt, filename: file.name }), true); }
    catch (err) { throw new Error(`El archivo se procesó pero NO se guardó en el servidor (${err.message}). Los demás usuarios no van a ver este cambio: probá de nuevo.`); }
    sucInitFiltersAndRender(); sucUpdateFooter();
    statusEl.textContent = `✓ ${newPos.length} posición(es) cargadas desde "${file.name}" (${posiciones.length} en total).`;
    statusEl.className = 'upload-status ok';
  } catch (err) { statusEl.textContent = '⚠ ' + err.message; statusEl.className = 'upload-status err'; }
  e.target.value = '';
});

/* ----- tabs ----- */
const TABS = ['bajas', 'mtp', 'altas', 'sucesion'];
function showTab(tab) {
  TABS.forEach(t => {
    $('view-' + t).hidden = tab !== t;
    $('tab-btn-' + t).classList.toggle('active', tab === t);
    $('tab-btn-' + t).setAttribute('aria-selected', tab === t);
  });
}
TABS.forEach(t => $('tab-btn-' + t).addEventListener('click', () => showTab(t)));

init();
mtpInit();
altasInit();
sucInit();
</script>
</body>
