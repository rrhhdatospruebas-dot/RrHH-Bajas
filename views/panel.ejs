/* ================================================================ */
/* % MUJERES: dotación real por planta y género, mes a mes.          */
/* Viene de un Excel aparte (% MUJERES.xlsx, pivots "NOMINA <mes>")  */
/* y reemplaza cualquier estimación por altas−bajas: es la dotación  */
/* real de cierre de cada mes, tal como la reporta C&B.              */
/* ================================================================ */
let MUJERES_DATA = {}; // { 'enero': [{site,f,m,tot}, ...], 'febrero': [...] }
function mujeresMonthKeys() {
  return Object.keys(MUJERES_DATA).sort((a, b) => (MES_NUM_MAP[a] || 0) - (MES_NUM_MAP[b] || 0));
}
function mujeresSiteList() {
  const map = new Map(); // siteKey -> fila representativa (la de mayor dotación vista)
  mujeresMonthKeys().forEach(k => (MUJERES_DATA[k] || []).forEach(row => {
    if (siteKey(row.site) === 'TOTALCIA') return;
    const sk = siteKey(row.site);
    if (!map.has(sk) || row.tot > map.get(sk).tot) map.set(sk, row);
  }));
  return [...map.values()].sort((a, b) => b.tot - a.tot).map(v => v.site);
}
function mujeresFor(mesNum, siteRaw) {
  const mesLabel = MES_NOM[mesNum] ? MES_NOM[mesNum].toLowerCase() : null;
  const rowsForMes = (mesLabel && MUJERES_DATA[mesLabel]) || [];
  if (!siteRaw) {
    return rowsForMes.filter(x => siteKey(x.site) !== 'TOTALCIA')
      .reduce((acc, v) => ({ f: acc.f + v.f, m: acc.m + v.m, tot: acc.tot + v.tot }), { f: 0, m: 0, tot: 0 });
  }
  const hit = rowsForMes.find(x => siteKey(x.site) === siteKey(siteRaw));
  return hit ? { f: hit.f, m: hit.m, tot: hit.tot } : { f: 0, m: 0, tot: 0 };
}
async function parseMujeresFile(file) {
  const buf = await file.arrayBuffer();
  const wb = XLSX.read(buf, { type: 'array', cellDates: true });
  const sheetName = wb.SheetNames.find(n => n.trim().toUpperCase() === '% MUJERES') || wb.SheetNames[0];
  const ws = wb.Sheets[sheetName];
  const rows = XLSX.utils.sheet_to_json(ws, { header: 1, raw: true, defval: null });
  const meses = {};
  let currentMes = null;
  for (let r = 0; r < rows.length; r++) {
    const row = rows[r] || [];
    const c0 = (row[0] == null ? '' : String(row[0])).trim();
    const nominaMatch = c0.match(/^NOMINA\s+(.+)$/i);
    if (nominaMatch) {
      const mesKey = nominaMatch[1].trim().toLowerCase();
      currentMes = MES_NUM_MAP[mesKey] ? mesKey : null;
      if (currentMes && !meses[currentMes]) meses[currentMes] = [];
      continue;
    }
    if (!currentMes) continue;
    if (/^etiquetas de fila$/i.test(c0)) continue;
    if (!c0) { currentMes = null; continue; }
    const f = typeof row[1] === 'number' ? row[1] : 0;
    const m = typeof row[2] === 'number' ? row[2] : 0;
    const tot = typeof row[3] === 'number' ? row[3] : (f + m);
    meses[currentMes].push({ site: c0, f, m, tot });
  }
  if (!Object.keys(meses).length) throw new Error('No se encontraron bloques "NOMINA <mes>" válidos en la hoja.');
  return meses;
}

const ALTAS_MOTIVO_DEFAULT = 'Adquisición';
const ACCENT_MAP = { á: 'a', é: 'e', í: 'i', ó: 'o', ú: 'u', Á: 'a', É: 'e', Í: 'i', Ó: 'o', Ú: 'u' };
function normalizeMotivo(s) {
  return (s == null ? '' : String(s)).trim().toLowerCase().replace(/[áéíóúÁÉÍÓÚ]/g, ch => ACCENT_MAP[ch]);
}
/* Agrupa el texto libre de "Motivo medida" en 4 categorías para el filtro; el texto que se
   muestra en pantalla siempre es el original de la celda, sin resumir ni reescribir. */
function motivoBucket(raw) {
  const n = normalizeMotivo(raw);
  if (n === 'adquisicion') return 'Adquisición';
  if (n === 'reemplazo') return 'Reemplazo';
  if (n === 'proyecto temporal') return 'Proyecto Temporal';
  return 'Otro (promoción / movimiento interno)';
}

const altasState = { mes: '', sitio: '', genero: '', motivo: '', vacante: '', q: '' };
let ALTAS_PERIOD_LABEL = '';

async function parseAltasFile(file) {
  const buf = await file.arrayBuffer();
  const wb = XLSX.read(buf, { type: 'array', cellDates: true });
  const sheetName = wb.SheetNames.find(n => n.trim().toUpperCase() === 'ALTAS') || wb.SheetNames[0];
  const ws = wb.Sheets[sheetName];
  const rows = XLSX.utils.sheet_to_json(ws, { header: 1, raw: true, defval: null });
  if (!rows.length) throw new Error('La hoja está vacía.');
  const headerRowIdx = findHeaderRowIndex(rows, 'Empleado (Cod)');
  if (headerRowIdx === -1) throw new Error('No se encontró la fila de encabezados ("Empleado (Cod)", "Motivo medida"…) en la hoja.');
  const header = rows[headerRowIdx].map(h => (h == null ? '' : String(h)).trim());
  const col = name => header.findIndex(h => h.toLowerCase() === name.toLowerCase());
  const idx = {
    cod: col('Empleado (Cod)'), nombre: col('Empleado'), fecha: col('Fecha'),
    mes: col('Mes'), div: col('Planta'), genero: col('Género'), motivo: col('Motivo medida'),
    vacante: col('Vacante cubierta (nombre puesto)'), cobertura: col('Tipo de cobertura (interna/externa)'),
  };
  for (const k of ['cod', 'nombre', 'fecha', 'mes', 'div', 'genero']) {
    if (idx[k] === -1) throw new Error(`Falta la columna requerida "${k}" en la hoja de altas.`);
  }
  const out = [];
  let skippedFecha = 0;
  for (let r = headerRowIdx + 1; r < rows.length; r++) {
    const row = rows[r];
    if (!row) continue;
    const cod = row[idx.cod], nombre = row[idx.nombre];
    if (cod == null || cod === '' || !nombre) continue;
    const mesTxt = (row[idx.mes] == null ? '' : String(row[idx.mes])).trim();
    const parsed = parseFecha(row[idx.fecha], mesTxt);
    if (!parsed) { skippedFecha++; continue; }
    const site = (row[idx.div] == null ? '' : String(row[idx.div])).trim() || 'Sin dato';
    const motivoRaw = idx.motivo > -1 && row[idx.motivo] != null ? String(row[idx.motivo]).trim() : 'Sin dato';
    const field = i => (i === -1 || row[i] == null) ? '' : String(row[i]).trim();
    out.push({
      n: String(nombre),
      g: (row[idx.genero] == null ? '' : String(row[idx.genero])).trim() === 'Masculino' ? 'M' : 'F',
      mo: motivoRaw,
      s: site,
      f: `${parsed.year}-${String(parsed.month).padStart(2, '0')}-${String(parsed.day).padStart(2, '0')}`,
      mes: parsed.month,
      vacante: field(idx.vacante), cobertura: field(idx.cobertura),
    });
  }
  return { records: out, skippedFecha };
}

function altasMonthYearLabel(records) {
  /* Usa el campo "mes" (siempre referido a 2026) en vez de la fecha completa: algunos ingresos
     corresponden a colaboradores que ya estaban en la empresa y cambiaron de puesto este año,
     por lo que su fecha de ingreso original puede ser de años anteriores. */
  if (!records.length) return 'Sin datos';
  const meses = [...new Set(records.map(r => r.mes))].sort((a, b) => a - b);
  const m1 = meses[0], m2 = meses[meses.length - 1];
  return m1 === m2 ? `${MES_NOM[m1]} 2026` : `${MES_NOM[m1]} a ${MES_NOM[m2]} 2026`;
}
function altasUpdateMeta() {
  ALTAS_PERIOD_LABEL = altasMonthYearLabel(ALTAS_DATA);
  $('altas-h1').textContent = `Altas de personal — ${ALTAS_PERIOD_LABEL}`;
  $('altas-footer-text').textContent = `Elaborado a partir de la planilla de altas (${ALTAS_DATA.length} registro${ALTAS_DATA.length === 1 ? '' : 's'}). Algunos registros corresponden a colaboradores que ya estaban en la empresa y cambiaron de puesto durante 2026; su fecha de ingreso original puede ser de años anteriores.`;
}
function altasSearchBlob(r) {
  return [r.n, r.s, r.mo, r.vacante, r.cobertura, r.g === 'M' ? 'masculino' : 'femenino', r.f].filter(Boolean).join(' ').toLowerCase();
}
function altasInitFiltersAndRender() {
  ALTAS_MESES = [...new Set(ALTAS_DATA.map(r => r.mes))].sort((a, b) => a - b);
  $('altas-f-mes').innerHTML = '<option value="">Todos</option>';
  ALTAS_MESES.forEach(m => $('altas-f-mes').insertAdjacentHTML('beforeend', `<option value="${m}">${MES_NOM[m]}</option>`));
  $('altas-f-sitio').innerHTML = '<option value="">Todos</option>';
  [...new Set(ALTAS_DATA.map(r => r.s))].sort((a, b) => a.localeCompare(b, 'es')).forEach(s =>
    $('altas-f-sitio').insertAdjacentHTML('beforeend', `<option value="${esc(s)}">${esc(s)}</option>`));
  const motivoBuckets = [...new Set(ALTAS_DATA.map(r => motivoBucket(r.mo)))].sort((a, b) => a === ALTAS_MOTIVO_DEFAULT ? -1 : b === ALTAS_MOTIVO_DEFAULT ? 1 : a.localeCompare(b, 'es'));
  $('altas-f-motivo').innerHTML = '<option value="">Todos</option>' + motivoBuckets.map(b => `<option value="${esc(b)}">${esc(b)}</option>`).join('');
  altasState.mes = ''; altasState.sitio = ''; altasState.genero = ''; altasState.vacante = ''; altasState.q = '';
  altasState.motivo = motivoBuckets.includes(ALTAS_MOTIVO_DEFAULT) ? ALTAS_MOTIVO_DEFAULT : '';
  $('altas-f-mes').value = ''; $('altas-f-sitio').value = ''; $('altas-f-genero').value = '';
  $('altas-f-motivo').value = altasState.motivo; $('altas-f-vacante').value = ''; $('altas-q').value = '';
  setActiveAltasGenderCard('');
  altasRender();
}
['altas-f-mes', 'altas-f-sitio', 'altas-f-genero', 'altas-f-motivo', 'altas-f-vacante'].forEach(id => $(id).addEventListener('change', () => {
