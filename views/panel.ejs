async function init() {
  try {
    const stored = await window.storage.get('bajas-dataset', true);
    if (stored && stored.value) {
      const parsed = JSON.parse(stored.value);
      if (parsed && Array.isArray(parsed.records) && parsed.records.length) {
        DATA = parsed.records;
        const fecha = parsed.uploadedAt ? new Date(parsed.uploadedAt).toLocaleString('es-AR') : '';
        $('upload-status').textContent = `Últimos datos cargados: "${parsed.filename || 'archivo'}"${fecha ? ' · ' + fecha : ''}`;
        $('upload-status').className = 'upload-status ok';
      }
    }
  } catch (err) {}
  initFiltersAndRender();
  updateMeta();
}
onChange('file-input', async (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const statusEl = $('upload-status');
  statusEl.textContent = 'Procesando archivo…'; statusEl.className = 'upload-status';
  try {
    const { records: newRecords, skippedIdentity, skippedFecha, unclassifiedMotivo } = await parseExcelFile(file);
    if (!newRecords.length) throw new Error('No se encontraron registros válidos en la hoja de bajas.');
    if (skippedIdentity || skippedFecha) {
      throw new Error(`No se actualizó el panel: ${skippedIdentity + skippedFecha} fila(s) incompleta(s) (${skippedIdentity} sin empleado/código y ${skippedFecha} con fecha inválida). Corregí esas filas y volvé a cargar el archivo.`);
    }
    const records = mergeRecordsByMonth(DATA, newRecords, r => r.f.slice(0, 7));
    DATA = records;
    const uploadedAt = new Date().toISOString();
    try { await window.storage.set('bajas-dataset', JSON.stringify({ records, uploadedAt, filename: file.name }), true); }
    catch (err) { throw new Error(`El archivo se procesó pero NO se guardó en el servidor (${err.message}). Los demás usuarios no van a ver este cambio: probá de nuevo.`); }
    initFiltersAndRender(); updateMeta();
    let msg = `✓ ${newRecords.length} registros cargados desde "${file.name}" (${records.length} en total tras combinar meses).`;
    if (unclassifiedMotivo) msg += ` ${unclassifiedMotivo} fila(s) incluida(s) como “Sin definir”.`;
    statusEl.textContent = msg; statusEl.className = 'upload-status ok';
  } catch (err) { statusEl.textContent = '⚠ ' + err.message; statusEl.className = 'upload-status err'; }
  e.target.value = '';
});

/* ================================================================ */
/* VISTA: COMPARACIÓN HEADCOUNT VS MTP                               */
/* ================================================================ */
/* A partir de FTE.xlsx los meses ya no son un rango fijo Ene–Jun: cada planta guarda un objeto
   `meses` con una entrada por mes (clave en minúscula: "enero", "febrero", ...), y el blueprint
   es un valor fijo por planta (no cambia mes a mes en el Excel de origen). */
const MTP_MESES_FIJOS_DEFAULT = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio'];
const MTP_DATA_DEFAULT_OLD = [{"planta":"Pta. Capdeville","baseline":148,"real":[174,175,175,173,177,178],"mtp":[174,175,175,173,177,178],"blueprint":153},{"planta":"Pta. Campana","baseline":90,"real":[100,101,100,96,99,99],"mtp":[100,101,100,96,99,99],"blueprint":92},{"planta":"Pta. Malagueño","baseline":222,"real":[269,270,269,268,264,262],"mtp":[269,270,269,268,264,264],"blueprint":159},{"planta":"Pta. Puesto Viejo","baseline":139,"real":[189,189,187,186,182,180],"mtp":[189,189,187,186,182,182],"blueprint":143},{"planta":"Añacua","baseline":8,"real":[13,12,13,12,15,17],"mtp":[13,12,13,12,15,18],"blueprint":null},{"planta":"RMX","baseline":49,"real":[52,55,56,57,60,59],"mtp":[52,55,56,57,60,60],"blueprint":null},{"planta":"Corpo","baseline":200,"real":[156,154,153,151,153,155],"mtp":[156,154,153,151,153,153],"blueprint":null},{"planta":"Agregados","baseline":25,"real":[25,24,24,24,24,25],"mtp":[25,24,24,24,24,26],"blueprint":null},{"planta":"Geocycle","baseline":56,"real":[55,55,54,54,54,53],"mtp":[55,55,54,54,54,54],"blueprint":null}];
function mtpDefaultToNested(arr) {
  return arr.map(p => {
    const meses = {};
    MTP_MESES_FIJOS_DEFAULT.forEach((mesKey, i) => { meses[mesKey] = { baseline: p.baseline, real: p.real[i] || 0, mtp: p.mtp[i] || 0 }; });
    return { planta: p.planta, blueprint: p.blueprint, meses };
  });
}
let MTP_DATA = mtpDefaultToNested(MTP_DATA_DEFAULT_OLD);
const mtpState = { mes: null, q: '' };

function mesLabel(mesKey) { return mesKey ? mesKey.charAt(0).toUpperCase() + mesKey.slice(1) : '–'; }
function mtpMesesList() {
  const set = new Set();
  MTP_DATA.forEach(p => Object.keys(p.meses || {}).forEach(k => set.add(k)));
  return [...set].sort((a, b) => (MES_NUM_MAP[a] || 0) - (MES_NUM_MAP[b] || 0));
}
function mtpEntry(p, mesKey) { return (p.meses && p.meses[mesKey]) || { baseline: 0, real: 0, mtp: 0 }; }
/* Objetivo del bloque general = MTP siempre (todas las plantas), sin usar Blueprint. */
function mtpObjetivo(p, mesKey) { return mtpEntry(p, mesKey).mtp || 0; }
function mtpTotalsFor(mesKey) {
  let real = 0, objetivo = 0, baseline = 0;
  MTP_DATA.forEach(p => { const e = mtpEntry(p, mesKey); real += e.real || 0; objetivo += e.mtp || 0; baseline += e.baseline || 0; });
  return { real, objetivo, baseline, gap: real - objetivo, gapBase: real - baseline };
}
function mtpRenderKPIs() {
  const mesKey = mtpState.mes;
  const { real, objetivo, baseline, gap, gapBase } = mtpTotalsFor(mesKey);
  $('mtp-k-real').textContent = real;
  $('mtp-k-real-sub').textContent = mesLabel(mesKey) + ' 2026';
  const baseEl = $('mtp-k-base');
  baseEl.textContent = (gapBase > 0 ? '+' : '') + gapBase;
  baseEl.className = 'val ' + (gapBase > 0 ? 'pos' : gapBase < 0 ? 'neg' : 'neutral');
  $('mtp-k-base-sub').textContent = `vs. ${baseline} al 31/12/25`;
  const gapEl = $('mtp-k-gap');
