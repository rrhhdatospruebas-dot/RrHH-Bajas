$('altas-q').addEventListener('input', e => { altasState.q = e.target.value.trim().toLowerCase(); altasRender(); });
function setActiveAltasGenderCard(g) {
  altasState.genero = g;
  $('altas-f-genero').value = g;
  ['altas-card-g-total', 'altas-card-g-m', 'altas-card-g-f'].forEach(id => {
