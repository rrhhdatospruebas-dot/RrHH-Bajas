async function mtpParseExcelFile(file) {
  const buf = await file.arrayBuffer();
  const wb = XLSX.read(buf, { type: 'array', cellDates: true });
  const sheetName = wb.SheetNames.find(n => n.trim().toLowerCase() === 'fte') || wb.SheetNames[0];
  const ws = wb.Sheets[sheetName];
  const rows = XLSX.utils.sheet_to_json(ws, { header: 1, raw: true, defval: null });
  if (!rows.length) throw new Error('La hoja está vacía.');
  const headerRowIdx = findHeaderRowIndex(rows, 'PLANTAS');
  if (headerRowIdx === -1) throw new Error('No se encontró la fila de encabezados ("PLANTAS", "headcount <mes>"…) en la hoja.');
  const header = rows[headerRowIdx];
  /* arma los bloques de 4 columnas por mes leyendo el nombre real del mes de "headcount <mes>" */
  const blocks = [];
  for (let c = 1; c < header.length; c++) {
    const h = (header[c] == null ? '' : String(header[c])).trim().toLowerCase();
    const m = h.match(/^headcount\s+(.+)$/);
    if (m && MES_NUM_MAP[m[1].trim()]) {
      blocks.push({ mesKey: m[1].trim(), colBaseline: c - 1, colReal: c, colMtp: c + 1, colBlueprint: c + 2 });
    }
  }
  if (!blocks.length) throw new Error('No se encontraron columnas "headcount <mes>" en la hoja.');
  const out = [];
  for (let r = headerRowIdx + 1; r < rows.length; r++) {
    const row = rows[r];
    if (!row || row[0] == null || String(row[0]).trim() === '') continue;
    const planta = String(row[0]).trim();
    const meses = {};
    let blueprintFijo = null;
    blocks.forEach(b => {
      const baseline = row[b.colBaseline], real = row[b.colReal], mtp = row[b.colMtp], bp = row[b.colBlueprint];
      meses[b.mesKey] = {
        baseline: typeof baseline === 'number' ? baseline : 0,
        real: typeof real === 'number' ? real : 0,
        mtp: typeof mtp === 'number' ? mtp : 0,
      };
      if (typeof bp === 'number') blueprintFijo = bp;
    });
    out.push({ planta, blueprint: blueprintFijo, meses });
  }
  if (!out.length) throw new Error('No se encontraron filas de plantas válidas en la hoja.');
  return out;
}
/* Los meses que trae el archivo nuevo reemplazan a los que ya había para esa planta; los meses que
   no vienen en el archivo nuevo se conservan. Una planta nueva se agrega completa. */
function mergeMtpByMonth(oldData, newData) {
  if (!oldData || !oldData.length) return newData;
  const byPlant = new Map(oldData.map(p => [siteKey(p.planta), p]));
  newData.forEach(np => {
    const key = siteKey(np.planta);
    const existing = byPlant.get(key);
    if (!existing) { byPlant.set(key, np); return; }
    Object.assign(existing.meses, np.meses);
    if (np.blueprint != null) existing.blueprint = np.blueprint;
    existing.planta = np.planta;
  });
  return [...byPlant.values()];
}
async function mtpInit() {
  try {
    const stored = await window.storage.get('mtp-dataset', true);
    if (stored && stored.value) {
      const parsed = JSON.parse(stored.value);
      if (parsed && Array.isArray(parsed.records) && parsed.records.length) {
        MTP_DATA = parsed.records;
        const fecha = parsed.uploadedAt ? new Date(parsed.uploadedAt).toLocaleString('es-AR') : '';
        $('mtp-upload-status').textContent = `Últimos datos cargados: "${parsed.filename || 'archivo'}"${fecha ? ' · ' + fecha : ''}`;
        $('mtp-upload-status').className = 'upload-status ok';
      }
    }
  } catch (err) {}
  mtpInitFiltersAndRender();
}
onChange('mtp-file-input', async (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const statusEl = $('mtp-upload-status');
  statusEl.textContent = 'Procesando archivo…'; statusEl.className = 'upload-status';
  try {
    const newRecords = await mtpParseExcelFile(file);
    const records = mergeMtpByMonth(MTP_DATA, newRecords);
    MTP_DATA = records;
    const uploadedAt = new Date().toISOString();
    try { await window.storage.set('mtp-dataset', JSON.stringify({ records, uploadedAt, filename: file.name }), true); }
    catch (err) { throw new Error(`El archivo se procesó pero NO se guardó en el servidor (${err.message}). Los demás usuarios no van a ver este cambio: probá de nuevo.`); }
    mtpInitFiltersAndRender();
    statusEl.textContent = `✓ ${newRecords.length} planta(s) actualizadas desde "${file.name}" (${records.length} plantas en total).`;
    statusEl.className = 'upload-status ok';
  } catch (err) { statusEl.textContent = '⚠ ' + err.message; statusEl.className = 'upload-status err'; }
  e.target.value = '';
});

