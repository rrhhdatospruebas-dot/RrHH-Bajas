function siteKey(raw) {
  return (raw == null ? '' : String(raw))
    .toUpperCase()
    .replace(/\bS\.?A\.?$/, '')
    .replace(/[^A-Z0-9]/g, ''); // saca espacios, puntos y acentos (Ñ, Á, ...) — solo para la clave interna
}

function titleDir(raw) {
