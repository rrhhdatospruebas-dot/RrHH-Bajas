  const s = (cell == null ? '' : String(cell)).trim();
  if (!s) return null;
  const mesKey = s.toLowerCase().split(/[\s\/\-,]/)[0];
  if (MES_NUM_MAP[mesKey]) {
    const yearMatch = s.match(/(20\d{2})/);
    return { year: yearMatch ? +yearMatch[1] : new Date().getFullYear(), month: MES_NUM_MAP[mesKey] };
